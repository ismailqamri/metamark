# ============================================================
# Legal Metrology Compliance Backend — environment template
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# server.py and the compliance modules read all config from here.
# NEVER commit your real .env (add it to .gitignore).
# ============================================================

# ---- Flask ----
# Used to sign session cookies. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# ---- MySQL ----
DB_HOST=localhost
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=amazon_scraper_db

# ---- Google Gemini (Generative AI API) ----
GOOGLE_API_KEY=your_gcp_api_key_here

# ============================================================
# OPTIONAL — scraper tuning (amazon_scraper/fetcher.py).
# All have sensible defaults; uncomment to override.
# ------------------------------------------------------------
# Route scraping through a (rotating) proxy:
# SCRAPER_PROXY=http://user:pass@host:port
# Max fetch attempts before giving up (default 4):
# SCRAPER_MAX_ATTEMPTS=4
# Per-request timeout in seconds (default 25):
# SCRAPER_TIMEOUT=25
# Enable headless-browser fallback: 1=on (default), 0=off:
# SCRAPER_BROWSER_FALLBACK=1
# Random polite delay range between requests, in seconds:
# SCRAPER_MIN_DELAY=0.5
# SCRAPER_MAX_DELAY=1.5
# ============================================================
